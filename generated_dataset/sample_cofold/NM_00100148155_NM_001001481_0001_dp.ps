AAUAAUGCUAAGACAAACUGA&UGACCCACCUCCUGGAAUGACCUUAAAUGAGAAGAGUGUUCAAAAUUCAAUUACACAGUGGAUUGUAGACAUGGAAGGUGCACCAGGUACCUUAUAUGAAGGGGAAAAAUUUCAACUUCUAUUUAAAUUUAGUAGUCGAUAUCCUUUUGACUCUCCUCAGGUCAUGUUUACUGGUGAAAAUAUUCCUGUUCAUCCUCAUGUUUAUAGCAAUGGUCAUAUCUGUUUAUCCAUUC\
